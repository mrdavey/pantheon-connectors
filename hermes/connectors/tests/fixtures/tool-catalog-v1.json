    {
      "name": "pantheon_command",
      "description": "Report working during work; completed, failed, time_ran_out or disconnected when execution ends, using target. Agree a definition of done before substantive work: definition uses text criteria, evidence assumptions, source derived/negotiated, expected previous definition version and exact objective_version/context_version. confirm uses target ID, expected version and text digest for either definition or result. result requires target agreed definition ID and evidence mapped to criteria. Result text is a human-readable outcome in one or two short sentences, targeting at most 60 words. Links are always optional: an agreement or decision can be the complete result without a website or artifact. If including a website link, verify its deployed public HTTPS destination. Never include localhost or loopback addresses in shared result text or evidence. Assess deployment only when the agreed objective explicitly requires it. Put checks and detailed limitations in evidence, keeping essential caveats in text. Review both before exact-version confirmation. To disagree use confirm source disagree and evidence with gaps/next step. Ready uses exact probe text after explicit ACK. Confirm the exact shared result against deliverable evidence before returning it in your own native conversation. Native owner delivery is a separate final step, not a result-confirmation prerequisite. These connectors expose no independently verified native handback receipt; do not call handback or inspect private session stores to invent one. If the owner explicitly requires such evidence, report the limitation before agreeing criteria.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "ready",
              "withdraw",
              "report",
              "definition",
              "result",
              "confirm"
            ]
          },
          "text": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "expected": {
            "type": "integer"
          },
          "objective_version": {
            "type": "integer"
          },
          "context_version": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "connection",
          "op",
          "key"
        ],
        "additionalProperties": false
      },
      "contract": "1",
      "execution": "remote",
      "operation": "command",
      "primitive": "",
      "authority": "chat.member",
      "mutating": true,
      "outputSchema": {
